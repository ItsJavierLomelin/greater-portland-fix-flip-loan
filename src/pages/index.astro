---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import {brand,domain,cities} from '../data/cities';
const title='Fix and Flip Loans in Greater Portland, ME | Greater Portland Fix & Flip Loan';
const description='We connect Portland, South Portland, Westbrook and Scarborough area investors with fix and flip funding sources. Funding within 48 hours. Tell us your goal.';
const businessId=`https://${domain}/#business`;
const faq=[{q:'Are you a direct lender?',a:'No. We are connectors. We introduce investors to funding sources, and the funding source determines eligibility and terms.'},{q:'Does submitting guarantee funding?',a:'No. A submission starts a review, not an approval or commitment.'}];
const areas=cities.map(c=>({'@type':'City',name:c.name,containedInPlace:{'@type':'State',name:'Maine'}}));
const jsonld=[{'@context':'https://schema.org','@type':'WebSite',name:brand,url:`https://${domain}/`},{'@context':'https://schema.org','@type':'FinancialService','@id':businessId,name:brand,url:`https://${domain}/`,areaServed:areas,description:'Fix and flip funding connections for real estate investors across Greater Portland, Maine, including Cumberland and southern York counties. Not a direct lender.'},{'@context':'https://schema.org','@type':'Service',serviceType:'Fix and flip funding connection service',provider:{'@id':businessId},areaServed:areas},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<Base title={title} description={description} path="/" jsonld={jsonld}><Header/><main><CityContent cityName="Greater Portland" location="Homepage" intro="From the triple-deckers of Portland's peninsula neighborhoods to the capes of Scarborough and the village streets of Yarmouth and Freeport, this coastal region rewards investors who know the block. Tell us about the home, the work you plan and how you expect to sell. We are connectors, and we introduce your project to funding sources for funding within 48 hours." angle="A Munjoy Hill multifamily, a Westbrook cape and a farmhouse in Gorham call for different repair scopes and different buyers. Start with the real condition of the property, the work you plan and recent sales on the same street or in the same town." caution="Heating oil tanks, granite and ledge foundations, radon and coastal flood zones all show up in this region, and the building season runs against the weather. Check them before you rely on a budget, and tell us what you have confirmed." showCityGrid={true}/></main><Footer/></Base>
